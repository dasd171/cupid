# ── Cupid environment configuration ──────────────────────────────
# Copy this file to `.env` and fill in the values for your setup.
# API keys are ONLY read on the server. They are never sent to the browser.

# Which AI provider to use: openai | compat | ollama | gemini
AI_PROVIDER=openai

# ── OpenAI (or any OpenAI-compatible API) ──────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: override the API base URL (defaults to https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Generic OpenAI-compatible API (OpenRouter, local servers, …) ──
# Used when AI_PROVIDER=compat
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── Ollama (local models) ──────────────────────────────────────────
# Used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# When running Cupid in Docker and Ollama on the host machine, use:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Google Gemini ──────────────────────────────────────────────────
# Used when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Privacy ────────────────────────────────────────────────────────
# Reports are held in server memory for 10 minutes only, never on disk.
# Reserved for future persistent storage options. Currently has no effect.
STORE_ANALYSIS=false
